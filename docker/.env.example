# Copy to docker/.env and fill in real values before running `docker compose up`.
# Never commit the real docker/.env file.

# PostgreSQL (container-internal — the app never talks to this from outside Docker)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=software-house
POSTGRES_PORT=5432

# Backend — generate strong random values, e.g. `openssl rand -base64 48`
JWT_SECRET=
JWT_REFRESH_SECRET=

# Origin allowed to call the API (the frontend's public URL)
CORS_ORIGIN=http://localhost:3000

# Frontend — base URL the browser uses to reach the API
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
